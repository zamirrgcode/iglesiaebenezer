<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Iglesia Ebenezer</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #1f1c2c, #928dab);
      color: #fff;
      scroll-behavior: smooth;
    }
    header {
      background: url('https://images.unsplash.com/photo-1508780709619-79562169bc64') no-repeat center center;
      background-size: cover;
      color: white;
      text-align: center;
      padding: 120px 20px;
    }
    header h1 {
      font-size: 4rem;
      color: #ffd700;
      font-weight: bold;
      animation: fadeInDown 2s;
    }
    header p {
      font-size: 1.5rem;
      animation: fadeInUp 2s;
    }
    section {
      margin: 60px auto;
      padding: 40px;
      background: rgba(255,255,255,0.05);
      border-radius: 12px;
      backdrop-filter: blur(10px);
      transition: all 0.8s ease;
    }
    section:hover { transform: scale(1.02); }
    h2 { color: #ffd700; font-weight: bold; }
    .card {
      background: rgba(255,255,255,0.1);
      border: none;
      color: #fff;
      transition: transform 0.3s ease;
    }
    .card:hover { transform: translateY(-5px) scale(1.05); }
    footer {
      background: rgba(0,0,0,0.8);
      color: #ffd700;
      text-align: center;
      padding: 20px;
    }
  </style>
</head>
<body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg fixed-top" style="background:rgba(0,0,0,0.6);backdrop-filter:blur(6px);">
  <div class="container">
    <a class="navbar-brand text-warning" href="#">Iglesia Ebenezer</a>
    <button class="navbar-toggler text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">☰</button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link text-warning" href="#quienes-somos">Quiénes somos</a></li>
        <li class="nav-item"><a class="nav-link text-warning" href="#galeria">Galería</a></li>
        <li class="nav-item"><a class="nav-link text-warning" href="#eventos">Eventos pasados</a></li>
        <!-- Enlace al otro apartado -->
        <li class="nav-item"><a class="nav-link text-warning" href="../eventos-iglesia-Ebenezer/">Invitaciones</a></li>
      </ul>
    </div>
  </div>
</nav>

<!-- Intro -->
<header class="animate__animated animate__fadeInDown">
  <h1>Ebenezer</h1>
  <p>Hasta aquí nos ayudó Jehová</p>
</header>

<!-- Quiénes somos -->
<section id="quienes-somos" class="container animate__animated animate__fadeInUp">
  <h2>Quiénes somos</h2>
  <div class="row mt-4">
    <div class="col-md-4">
      <div class="card p-3">
        <h5>Fe</h5>
        <p>Somos una iglesia cristiana comprometida con la enseñanza de la Palabra y el crecimiento espiritual.</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card p-3">
        <h5>Comunidad</h5>
        <p>Promovemos la comunión fraterna y el servicio, fortaleciendo familias y lazos comunitarios.</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card p-3">
        <h5>Esperanza</h5>
        <p>Buscamos ser luz en la sociedad, transmitiendo esperanza y amor a través de Cristo.</p>
      </div>
    </div>
  </div>
</section>

<!-- Galería -->
<section id="galeria" class="container animate__animated animate__fadeInUp">
  <h2>Galería</h2>
  <div class="row mt-4">
    <div class="col-md-4 mb-3"><img src="https://images.unsplash.com/photo-1529070538774-1843cb3265df" class="img-fluid rounded" alt="Galería 1"></div>
    <div class="col-md-4 mb-3"><img src="https://images.unsplash.com/photo-1524492449090-1a9f3d80d1a8" class="img-fluid rounded" alt="Galería 2"></div>
    <div class="col-md-4 mb-3"><img src="https://images.unsplash.com/photo-1508780709619-79562169bc64" class="img-fluid rounded" alt="Galería 3"></div>
  </div>
</section>

<!-- Eventos pasados -->
<section id="eventos" class="container animate__animated animate__fadeInUp">
  <h2>Eventos pasados</h2>
  <div class="row mt-4">
    <div class="col-md-4">
      <div class="card p-3">
        <h5>Aniversario 2025</h5>
        <p>Celebramos con alabanzas, predicación y comunión fraterna.</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card p-3">
        <h5>Campamento Juvenil</h5>
        <p>Un espacio de reflexión y crecimiento para los jóvenes.</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card p-3">
        <h5>Concierto de Alabanza</h5>
        <p>Un tiempo de adoración y música para toda la comunidad.</p>
      </div>
    </div>
  </div>
</section>

<!-- Footer -->
<footer>
  <p>&copy; 2026 Iglesia Ebenezer – <span class="gold-text">Hasta aquí nos ayudó Jehová</span></p>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
